flowchart TD
  tx["Transacción orden y outbox"] --> publish["Worker reclama y publica"]
  publish --> sdk["AmazonSQSClient"]
  sdk --> queue["SQS Standard"]
  queue --> inbox["Inbox verifica evento y lease"]
  inbox --> handle["Handler idempotente"]
  handle --> ack["Commit durable y DeleteMessage"]
  handle --> retry["Visibilidad y backoff"]
  retry --> queue
  queue --> dlq["DLQ tras cinco recepciones"]
  dlq --> replay["Revisión y redrive autorizado"]
  replay --> queue
